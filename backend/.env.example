# скопируйте в .env и заполните
CORS_ORIGINS=["http://localhost:5173"]
ADMIN_TOKEN=
DATABASE_PATH=leads.db

# уведомление на почту о новой заявке — необязательно, без него заявки
# по-прежнему сохраняются в базу, просто письмо не уходит.
# SMTP_USER/SMTP_PASSWORD — пароль приложения Gmail (не обычный пароль от аккаунта):
# myaccount.google.com/apppasswords, нужна включённая двухфакторка.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=ivedesign93@gmail.com
